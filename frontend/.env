# URL da API
REACT_APP_API_BASE_URL=http://localhost:5000

# URL do frontend (se for usada em algum ponto do app)
REACT_APP_FRONTEND_URL=http://localhost:3000

# Configuração de ambiente (útil para diferenciar produção e desenvolvimento)
REACT_APP_ENV=development

# Outras configurações que você pode precisar
REACT_APP_WEBSITE_NAME=VirtualLibrary
